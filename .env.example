# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — server-only
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=teavitused@sinudomeen.ee
# Must match the tutor_email row in app_settings — that is what makes an
# account the admin at signup.
TUTOR_NOTIFICATION_EMAIL=rtubarik@gmail.com

# The shared front-door password
SITE_GATE_PASSWORD=RaulTubarikEraõpilane

# Used to build links in notification emails
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Google Kalender (valikuline) — teenusekonto, mis loeb õpetaja kalendrit.
# Ilma nendeta on kalendriosa rakenduses lihtsalt peidus.
GOOGLE_SERVICE_ACCOUNT_EMAIL=matemaatika@sinu-projekt.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=rtubarik@gmail.com
